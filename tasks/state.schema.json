{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lattice.local/schemas/task-state-v1.json",
  "title": "Lattice Codex task state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_baseline",
    "current_milestone",
    "current_task",
    "allowed_statuses",
    "tasks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product_baseline": { "type": "string", "minLength": 1 },
    "current_milestone": { "type": "string", "pattern": "^M[0-8]$" },
    "current_task": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^M[0-8]-T[0-9]{2}$" }
      ]
    },
    "allowed_statuses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["blocked", "ready", "in_progress", "awaiting_manual", "passed", "failed"]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "depends_on", "manual_gate", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-8]-T[0-9]{2}$" },
          "status": {
            "enum": ["blocked", "ready", "in_progress", "awaiting_manual", "passed", "failed"]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^M[0-8]-T[0-9]{2}$" }
          },
          "manual_gate": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "summary", "recorded_at"],
              "properties": {
                "kind": { "enum": ["command", "test", "report", "manual"] },
                "summary": { "type": "string", "minLength": 1 },
                "path": { "type": "string" },
                "recorded_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    }
  }
}
